// The architecture of Capabilities as it is today. Every pull request that changes it updates this model (ADR 0039).
model {

  explorer = actor 'Explorer' {
    description 'Anyone asking what it takes to make or do something, what else a group could do, or whether a job was feasible.'
  }

  contributor = actor 'Contributor' {
    description 'Adds and corrects data and code through pull requests.'
  }

  github = external 'GitHub' {
    description 'Hosts the repository and pull requests, and runs CI (GitHub Actions): validate, build the graph, tests, lint and the web build.'
  }

  openfreemap = external 'OpenFreeMap' {
    description 'Free public vector tiles of OpenStreetMap data (ODbL), with light and dark styles. The browser fetches them when the map opens (ADR 0042).'
  }

  mrds = external 'USGS MRDS' {
    description 'The Mineral Resources Data System: 304,632 mineral deposits worldwide, with coordinates, ore minerals and commodities. US public domain. Downloaded as mrds-csv.zip.'
  }

  wikidata = external 'Wikidata' {
    description 'The free knowledge base of Wikimedia, CC0. Its SPARQL endpoint (query.wikidata.org) answers one query for the quantity statements (Mohs hardness) of the items our things are matched to (ADR 0043).'
  }

  capabilities = system 'Capabilities' {
    description 'A free, non-commercial knowledge graph of what it physically takes to make and do things, with a reasoner that answers three questions.'

    curated = store 'Curated layer' {
      technology 'YAML files in git, checked by JSON Schema; CSV crosswalks and suppressions'
      description 'data/ (things, routes, verbs, quantities, profiles, overrides, crosswalks, suppressions), examples/jobs/ and schema/. Written by people, reviewed in pull requests.'
    }

    snapshots = store 'Upstream snapshots' {
      #generated
      technology 'Parquet and snapshot.json (build/upstream/)'
      description 'Each upstream dataset as downloaded, every column as text, with its URL, retrieval time, hash and license. Downloaded only by Dagster; not in git.'
    }

    pipeline = container 'Pipeline' {
      technology 'Python, dbt Core, dbt-duckdb, Dagster'
      description 'pipeline/: builds the graph from its inputs, with `capabilities build` or as Dagster assets.'

      loader = component 'Loader' {
        technology 'Python (capabilities_pipeline.build)'
        description 'Loads every curated document, crosswalk, suppression and downloaded snapshot into raw DuckDB tables, with the inputs fingerprint. Writes the manifest last.'
      }
      downloader = component 'Downloader' {
        technology 'Python (capabilities_pipeline.upstream)'
        description 'Downloads an upstream dataset (a zip, or the result of a SPARQL query built from the curated layer), checks its columns, converts it to Parquet unchanged and records the snapshot.'
      }
      dagster = component 'Dagster assets' {
        technology 'Dagster, dagster-dbt (assets.py, definitions.py)'
        description 'The same steps as assets, plus the MRDS and Wikidata downloads: grouped upstream, raw, staging and marts. dbt tests are asset checks. `dg dev` shows lineage and run history.'
      }
      dbt = component 'dbt project' {
        technology 'dbt Core with the DuckDB adapter'
        description 'pipeline/dbt: sources, staging views and marts, with data tests. Marts are written as Parquet; geometries use the DuckDB spatial extension.'
      }
    }

    warehouse = store 'Warehouse' {
      #generated
      technology 'DuckDB (build/warehouse.duckdb)'
      description 'Where the build stages and transforms data. Generated; not in git.'

      rawDocuments = table 'raw.curated_documents' {
        description 'One row per curated document: ordinal, node_type, id, document (JSON), path.'
      }
      rawCrosswalk = table 'raw.mrds_sources' {
        description 'The crosswalk from MRDS deposits to our source kinds (data/crosswalks/mrds_sources.csv): field, value, optional deposit type, notes.'
      }
      rawWikidataCrosswalk = table 'raw.wikidata_things' {
        description 'The crosswalk from our things to Wikidata items (data/crosswalks/wikidata_things.csv): id, wikidata, notes.'
      }
      rawSuppressions = table 'raw.suppressed_records' {
        description 'Upstream records left out of the build, with why (data/suppressions/suppressed_records.csv).'
      }
      rawWikidata = table 'raw.wikidata_quantities' {
        description 'The Wikidata snapshot: item, property, amount, bounds and unit of each best-ranked statement, as text. Empty when nothing has been downloaded.'
      }
      rawMrds = table 'raw.mrds_deposits' {
        description 'The MRDS snapshot, all 46 columns as text. Empty when nothing has been downloaded.'
      }
      rawSnapshots = table 'raw.upstream_snapshots' {
        description 'Each snapshot loaded: dataset, URL, retrieval time, hash, rows, license.'
      }
      rawLoads = table 'raw.loads' {
        description 'The fingerprint of the inputs the last load read, and when. The manifest copies it.'
      }
      stgDocuments = table 'stg_curated__documents' {
        technology 'dbt view'
        description 'Common fields (kind, label) pulled out of each document.'
      }
      stgCuratedQuantities = table 'stg_curated__quantities, __overrides, __quantity_properties' {
        technology 'dbt views'
        description 'The curated quantity values, the overrides, and the Wikidata property each quantity is read from.'
      }
      stgWikidata = table 'stg_wikidata__quantities' {
        technology 'dbt view'
        description 'Wikidata statements typed: amount, low and high (the bounds, or the amount).'
      }
      stgMrds = table 'stg_mrds__deposits' {
        technology 'dbt view'
        description 'MRDS deposits typed: coordinates as numbers, ore minerals and commodities as lists, first production year and qualifier.'
      }
    }

    artifact = store 'Built graph' {
      #generated
      technology 'Parquet and JSON (build/graph/)'
      description 'What the app reads (ADR 0038). Generated; not in git.'

      graphNodes = file 'graph_nodes.parquet' {
        technology 'dbt mart, external materialization'
        description 'Every node: type, id, kind, label, full document, provenance, and read order.'
      }
      graphFacts = file 'graph_facts.parquet' {
        technology 'dbt mart, external materialization'
        description 'Where each quantity value comes from: one row per thing and quantity, with the value used (override, else upstream, else curated), the value from each layer, whether they disagree, the upstream record and the override (ADR 0043).'
      }
      occurrences = file 'source_occurrences.parquet' {
        technology 'dbt mart, external materialization, GeoParquet'
        description 'Where each source kind is found: one row per source kind and MRDS deposit, with a point geometry, worked_by_year, state (worked or present) and upstream provenance (ADR 0041).'
      }
      manifest = file 'manifest.json' {
        description 'Format version, input fingerprint, build time, git commit, row counts and the upstream snapshots used. A build is current when its fingerprint matches the inputs.'
      }
    }

    core = container 'Core library' {
      technology 'Python package `capabilities`'
      description 'packages/core: the in-memory graph, reasoner, validator and the `capabilities` CLI.'

      built = component 'Built-graph reader' {
        technology 'capabilities.built'
        description 'Checks the fingerprint, rebuilds when stale, and loads the built graph into memory, with where each quantity value came from.'
      }
      reasoner = component 'Reasoner' {
        technology 'capabilities.reasoner, levels, views'
        description 'Answers Q1 (what would it take), Q2 (what else) and Q3 (could it be done), and shapes results for the UI.'
      }
      places = component 'Places' {
        technology 'capabilities.places, capabilities.built.load_occurrences'
        description 'Where a material or source is found: the occurrences of every source it comes from, summarised per source, as GeoJSON.'
      }
      validator = component 'Validator' {
        technology 'capabilities.validate, jsonschema'
        description 'Checks every curated file against its schema and every cross-reference.'
      }
      cli = component 'CLI' {
        technology 'argparse (`capabilities`)'
        description 'validate, build, need, explore, check, credits, serve.'
      }
    }

    api = container 'API server' {
      technology 'FastAPI, Uvicorn'
      description 'packages/api: the JSON API under /api, and hosts the web app at / and these diagrams at /architecture/.'
    }

    web = container 'Web app' {
      technology 'React, TypeScript, Vite, Cytoscape.js, MapLibre GL JS'
      description 'web/: the graph, selection panes and detail pane, and the map of where things are found (lazy-loaded), built to web/dist.'
    }

    diagrams = container 'Architecture diagrams' {
      technology 'LikeC4'
      description 'docs/architecture/diagrams, built into a static site by `npm run build` in web/.'
    }
  }

  // People and outside systems
  explorer -> capabilities.web 'explores the graph in a browser'
  explorer -> capabilities.diagrams 'reads how it is built'
  contributor -> capabilities.curated 'edits data through pull requests'
  contributor -> capabilities.core.cli 'validates, builds and asks questions'
  contributor -> capabilities.pipeline.dagster 'runs builds and reads lineage in the Dagster UI'
  github -> capabilities 'runs CI on every pull request'

  // Serving
  capabilities.web -> capabilities.api 'calls /api (JSON over HTTP)'
  capabilities.api -> capabilities.web 'hosts the built app'
  capabilities.api -> capabilities.diagrams 'hosts at /architecture/'
  capabilities.api -> capabilities.core.reasoner 'asks the three questions'
  capabilities.api -> capabilities.core.built 'loads the graph at start-up'
  capabilities.api -> capabilities.core.places 'where a material or source is found (/api/occurrences)'
  capabilities.core.places -> capabilities.artifact.occurrences 'loads every occurrence at start-up'
  capabilities.core.places -> capabilities.artifact.manifest 'which upstream snapshots, and when'
  capabilities.web -> openfreemap 'fetches basemap tiles when the map opens'
  capabilities.core.cli -> capabilities.core.reasoner 'asks the three questions'
  capabilities.core.cli -> capabilities.core.built 'loads the graph'
  capabilities.core.cli -> capabilities.core.validator 'validate'
  capabilities.core.validator -> capabilities.curated 'checks every file'

  // Building the graph
  capabilities.core.built -> capabilities.pipeline.loader 'rebuilds when the inputs changed'
  capabilities.core.built -> capabilities.artifact.manifest 'compares fingerprints'
  capabilities.core.built -> capabilities.artifact.graphNodes 'reads every node'
  capabilities.core.built -> capabilities.artifact.graphFacts 'reads where each value came from'
  capabilities.core.built -> capabilities.snapshots 'includes each snapshot.json in the fingerprint'
  capabilities.pipeline.loader -> capabilities.curated 'reads every document'
  capabilities.pipeline.loader -> capabilities.warehouse.rawDocuments 'loads documents, whole'
  capabilities.pipeline.loader -> capabilities.warehouse.rawLoads 'records the inputs fingerprint'
  capabilities.pipeline.loader -> capabilities.warehouse.rawCrosswalk 'loads each crosswalk, as text'
  capabilities.pipeline.loader -> capabilities.snapshots 'reads the snapshots already downloaded'
  capabilities.pipeline.loader -> capabilities.warehouse.rawMrds 'loads the MRDS snapshot (or an empty table)'
  capabilities.pipeline.loader -> capabilities.warehouse.rawSnapshots 'records each snapshot loaded'
  capabilities.pipeline.loader -> capabilities.warehouse.rawWikidataCrosswalk 'loads the crosswalk, as text'
  capabilities.pipeline.loader -> capabilities.warehouse.rawSuppressions 'loads the suppressions, as text'
  capabilities.pipeline.loader -> capabilities.warehouse.rawWikidata 'loads the Wikidata snapshot (or an empty table)'
  capabilities.pipeline.dagster -> capabilities.pipeline.downloader 'downloads MRDS and Wikidata as assets'
  capabilities.pipeline.downloader -> mrds 'downloads mrds-csv.zip (HTTPS)'
  capabilities.pipeline.downloader -> wikidata 'one SPARQL query for the crosswalked items (HTTPS)'
  capabilities.pipeline.downloader -> capabilities.curated 'reads the crosswalk and quantities to build the query'
  capabilities.pipeline.downloader -> capabilities.snapshots 'writes Parquet, then snapshot.json'
  capabilities.pipeline.dagster -> capabilities.pipeline.loader 'runs the load and manifest as assets'
  capabilities.pipeline.dagster -> capabilities.pipeline.dbt 'runs every model as an asset, tests as checks'
  capabilities.pipeline.loader -> capabilities.pipeline.dbt 'runs dbt build'
  capabilities.pipeline.loader -> capabilities.artifact.manifest 'writes it last, with the loaded fingerprint'
  capabilities.pipeline.dbt -> capabilities.warehouse.rawDocuments 'source, with data tests'
  capabilities.pipeline.dbt -> capabilities.warehouse.stgDocuments 'builds the staging view'
  capabilities.pipeline.dbt -> capabilities.artifact.graphNodes 'writes the mart as Parquet, with data tests'
  capabilities.pipeline.dbt -> capabilities.warehouse.stgMrds 'builds the staging view'
  capabilities.pipeline.dbt -> capabilities.artifact.occurrences 'writes the mart as GeoParquet, with data tests'
  capabilities.pipeline.dbt -> capabilities.artifact.graphFacts 'writes the mart as Parquet, with data tests'
  capabilities.warehouse.rawDocuments -> capabilities.warehouse.stgDocuments 'parsed into columns'
  capabilities.warehouse.stgDocuments -> capabilities.artifact.graphNodes 'adds provenance'
  capabilities.warehouse.stgDocuments -> capabilities.warehouse.stgCuratedQuantities 'quantities, overrides, properties'
  capabilities.warehouse.rawWikidata -> capabilities.warehouse.stgWikidata 'typed'
  capabilities.warehouse.stgWikidata -> capabilities.artifact.graphFacts 'upstream values'
  capabilities.warehouse.stgCuratedQuantities -> capabilities.artifact.graphFacts 'curated values and overrides'
  capabilities.warehouse.rawWikidataCrosswalk -> capabilities.artifact.graphFacts 'which item each thing is'
  capabilities.warehouse.rawSuppressions -> capabilities.artifact.graphFacts 'items left out'
  capabilities.warehouse.rawSuppressions -> capabilities.artifact.occurrences 'deposits left out'
  capabilities.artifact.graphFacts -> capabilities.artifact.graphNodes 'the chosen values, into each document'
  capabilities.warehouse.rawMrds -> capabilities.warehouse.stgMrds 'typed, lists split'
  capabilities.warehouse.stgMrds -> capabilities.artifact.occurrences 'deposits with coordinates, as points'
  capabilities.warehouse.rawCrosswalk -> capabilities.artifact.occurrences 'match rules'
  capabilities.warehouse.rawSnapshots -> capabilities.artifact.occurrences 'retrieval time, for provenance'
}
