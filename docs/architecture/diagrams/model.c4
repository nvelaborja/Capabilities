// The architecture of Capabilities as it is today. Every pull request that changes it updates this model (ADR 0039).
model {

  explorer = actor 'Explorer' {
    description 'Anyone asking what it takes to make or do something, what else a group could do, or whether a job was feasible.'
  }

  contributor = actor 'Contributor' {
    description 'Adds and corrects data and code through pull requests.'
  }

  github = external 'GitHub' {
    description 'Hosts the repository and pull requests, agents\' draft pull requests among them, and runs CI (GitHub Actions): validate, build the graph, tests, lint and the web build.'
  }

  openfreemap = external 'OpenFreeMap' {
    description 'Free public vector tiles of OpenStreetMap data (ODbL), with light and dark styles. The browser fetches them when the map opens (ADR 0042).'
  }

  mrds = external 'USGS MRDS' {
    description 'The Mineral Resources Data System: 304,632 mineral deposits worldwide, with coordinates, ore minerals and commodities. US public domain. Downloaded as mrds-csv.zip.'
  }

  wikidata = external 'Wikidata' {
    description 'The free knowledge base of Wikimedia, CC0. Its SPARQL endpoint (query.wikidata.org) answers two queries about the items our things and ore minerals are matched to: their quantity statements (Mohs hardness, ADR 0043), and their labels, descriptions and formulas (ADR 0045).'
  }

  pleiades = external 'Pleiades' {
    description 'A community-built gazetteer of ancient places, CC BY 3.0. Its daily dump (pleiades-places-latest.csv.gz) holds every place, with its types, tags, location and the periods it is attested in; its mines and quarries place our sources and ore classes (ADR 0046).'
  }

  openalex = external 'OpenAlex' {
    description 'An open index of scholarly works, CC0. Its API finds each work we cite, by DOI or by searching its title, and knows where free copies are (ADR 0047).'
  }

  crossref = external 'Crossref' {
    description 'The DOI registration agency; its REST API serves publishers\' bibliographic metadata, without restrictions. It finds each work we cite by DOI, or from the whole citation (query.bibliographic) (ADR 0047).'
  }

  claude = external 'Claude, through Claude Code' {
    description 'Anthropic\'s Claude models, reached through the Claude Code CLI in print mode (claude -p) on the owner\'s Claude subscription, so agent runs draw on the plan\'s usage limits rather than an API bill. Each call starts clean, with no tools: it only judges what the pipeline found (ADR 0048).'
  }

  theWeb = external 'The web' {
    description 'The pages agents\' proposals cite: papers, museum, university and survey pages. The pipeline finds and downloads them itself (ADR 0048); no model reads the web.'
  }

  capabilities = system 'Capabilities' {
    description 'A free, non-commercial knowledge graph of what it physically takes to make and do things, with a reasoner that answers three questions.'

    curated = store 'Curated layer' {
      technology 'YAML files in git, checked by JSON Schema; CSV crosswalks and suppressions'
      description 'data/ (things, routes, verbs, quantities, profiles, overrides, crosswalks, suppressions), examples/jobs/ and schema/. Written by people, reviewed in pull requests.'
    }

    snapshots = store 'Upstream snapshots' {
      #generated
      technology 'Parquet and snapshot.json (build/upstream/)'
      description 'Each upstream dataset as downloaded, every column as text, with its URL, retrieval time, hash and license. Downloaded only by Dagster; not in git.'
    }

    backups = store 'Cold backups' {
      technology 'Parquet (zstd) and snapshot.json, in git (snapshots/)'
      description 'A copy of every upstream dataset, so the graph builds offline, in CI and when a download fails. Every dataset is required: a build uses the newest copy, download or backup, and stops if one has neither (ADR 0044).'
    }

    audit = store 'Audit log' {
      technology 'DuckDB, append-only (audit/agents.duckdb), not in git'
      description 'Every agent run: its start and end, every call (prompt version, model, answer, tool calls, tokens, the plan\'s usage), every mechanical check and every outcome. Rows are only ever added (ADR 0048).'
    }

    pipeline = container 'Pipeline' {
      technology 'Python, dbt Core, dbt-duckdb, Dagster'
      description 'pipeline/: builds the graph from its inputs, with `capabilities build` or as Dagster assets.'

      loader = component 'Loader' {
        technology 'Python (capabilities_pipeline.build)'
        description 'Loads every curated document, crosswalk, suppression and downloaded snapshot into raw DuckDB tables, with the inputs fingerprint. Writes the manifest last.'
      }
      downloader = component 'Downloader' {
        technology 'Python (capabilities_pipeline.upstream)'
        description 'Downloads an upstream dataset (a zip, or the result of a SPARQL query built from the curated layer), checks its columns, converts it to Parquet unchanged and records the snapshot.'
      }
      dagster = component 'Dagster assets' {
        technology 'Dagster, dagster-dbt (assets.py, definitions.py)'
        description 'The same steps as assets, plus the MRDS and Wikidata downloads: grouped upstream, raw, staging and marts. dbt tests are asset checks. `dg dev` shows lineage and run history.'
      }
      agents = component 'Agent curation' {
        technology 'Python, Claude Code CLI, Dagster job agent_curation (capabilities_pipeline.agents)'
        description 'Started by hand with a task and a size: ore candidates (a crosswalk row each, ADR 0048) or routes whose references are all unverified (a quoted source each, ADR 0049). Code finds the passages; a proposer agent chooses one; code checks it; a reviewer agent challenges it. Accepted changes are validated, built and tested in a temporary worktree and opened as a draft pull request (ADR 0035).'
      }
      dbt = component 'dbt project' {
        technology 'dbt Core with the DuckDB adapter'
        description 'pipeline/dbt: sources, staging views and marts, with data tests. Marts are written as Parquet; geometries use the DuckDB spatial extension.'
      }
    }

    warehouse = store 'Warehouse' {
      #generated
      technology 'DuckDB (build/warehouse.duckdb)'
      description 'Where the build stages and transforms data. Generated; not in git.'

      rawDocuments = table 'raw.curated_documents' {
        description 'One row per curated document: ordinal, node_type, id, document (JSON), path.'
      }
      rawCrosswalk = table 'raw.mrds_sources' {
        description 'The crosswalk from MRDS deposits to our source kinds (data/crosswalks/mrds_sources.csv): field, value, optional deposit type, notes.'
      }
      rawWikidataCrosswalk = table 'raw.wikidata_things' {
        description 'The crosswalk from our things to Wikidata items (data/crosswalks/wikidata_things.csv): id, wikidata, notes.'
      }
      rawOreMinerals = table 'raw.ore_minerals' {
        description 'The hand-kept crosswalk of ore minerals that join the graph (data/crosswalks/ore_minerals.csv): Wikidata item, MRDS name, ore class, the route it is mined like, and its reference.'
      }
      rawWikidataItems = table 'raw.wikidata_items' {
        description 'The Wikidata items snapshot: the label, description and chemical formula of each crosswalked item, as text.'
      }
      rawSuppressions = table 'raw.suppressed_records' {
        description 'Upstream records left out of the build, with why (data/suppressions/suppressed_records.csv).'
      }
      rawWikidata = table 'raw.wikidata_quantities' {
        description 'The Wikidata snapshot: item, property, amount, bounds and unit of each best-ranked statement, as text.'
      }
      rawMrds = table 'raw.mrds_deposits' {
        description 'The MRDS snapshot, all 46 columns as text.'
      }
      rawPleiades = table 'raw.pleiades_places' {
        description 'The Pleiades snapshot, all 26 columns as text.'
      }
      rawReferenceCandidates = table 'raw.reference_candidates' {
        description 'What OpenAlex and Crossref answered for each cited work (a few candidates per lookup), and the HTTP status of each cited link, as text.'
      }
      rawPleiadesRules = table 'raw.pleiades_sources' {
        description 'Rules placing Pleiades mines and quarries (data/crosswalks/pleiades_sources.csv): a target source or ore class, a kind of place and a word.'
      }
      rawSnapshots = table 'raw.upstream_snapshots' {
        description 'Each snapshot loaded: dataset, URL, retrieval time, hash, rows, license.'
      }
      rawLoads = table 'raw.loads' {
        description 'The fingerprint of the inputs the last load read, and when. The manifest copies it.'
      }
      stgDocuments = table 'stg_curated__documents' {
        technology 'dbt view'
        description 'Common fields (kind, label) pulled out of each document.'
      }
      stgCuratedQuantities = table 'stg_curated__quantities, __overrides, __quantity_properties' {
        technology 'dbt views'
        description 'The curated quantity values, the overrides, and the Wikidata property each quantity is read from.'
      }
      stgWikidata = table 'stg_wikidata__quantities' {
        technology 'dbt view'
        description 'Wikidata statements typed: amount, low and high (the bounds, or the amount).'
      }
      stgOreNodes = table 'stg_ore_minerals__nodes, stg_wikidata__items, stg_crosswalk__wikidata_items' {
        technology 'dbt views'
        description 'The upstream nodes: for each ore mineral, a material named from Wikidata, its deposit, and a mining route cloned from a curated one (ADR 0045).'
      }
      stgMrds = table 'stg_mrds__deposits' {
        technology 'dbt view'
        description 'MRDS deposits typed: coordinates as numbers, ore minerals and commodities as lists, first production year and qualifier.'
      }
      stgReferences = table 'stg_references__cited, __candidates' {
        technology 'dbt views'
        description 'Every reference in the graph, one row per use (found anywhere in each document with json_tree); and the candidates typed, with their titles reduced to words for comparing.'
      }
      stgPleiades = table 'stg_pleiades__workings' {
        technology 'dbt view'
        description 'Pleiades mines and quarries: the kinds of place, the materials they name (tags) and their text, location and precision, attested years and periods.'
      }
    }

    artifact = store 'Built graph' {
      #generated
      technology 'Parquet and JSON (build/graph/)'
      description 'What the app reads (ADR 0038). Generated; not in git.'

      graphNodes = file 'graph_nodes.parquet' {
        technology 'dbt mart, external materialization'
        description 'Every node: type, id, kind, label, full document, provenance, and read order.'
      }
      graphFacts = file 'graph_facts.parquet' {
        technology 'dbt mart, external materialization'
        description 'Where each quantity value comes from: one row per thing and quantity, with the value used (override, else upstream, else curated), the value from each layer, whether they disagree, the upstream record and the override (ADR 0043).'
      }
      queue = file 'curation_queue.parquet' {
        technology 'dbt mart, external materialization'
        description 'The gaps the build found, most valuable first: ore candidates from MRDS, extracted materials with no route, sources with no places, routes with only unverified references, disagreements and stale overrides (ADR 0045), the works not yet read (ADR 0047), and unmatched Pleiades places (ADR 0046).'
      }
      checks = file 'reference_checks.parquet' {
        technology 'dbt mart, external materialization'
        description 'Every cited work checked: found, only a review found, possible, not found, a DOI leading elsewhere, not searched (a web page) or not checked yet; the record matched, a free copy, and whether each cited link loads. Never changes a status (ADR 0047).'
      }
      occurrences = file 'source_occurrences.parquet' {
        technology 'dbt mart, external materialization, GeoParquet'
        description 'Where each source kind is found: one row per source kind and MRDS deposit, with a point geometry, worked_by_year, state (worked or present) and upstream provenance (ADR 0041).'
      }
      manifest = file 'manifest.json' {
        description 'Format version, input fingerprint, build time, git commit, row counts and the upstream snapshots used. A build is current when its fingerprint matches the inputs.'
      }
    }

    core = container 'Core library' {
      technology 'Python package `capabilities`'
      description 'packages/core: the in-memory graph, reasoner, validator and the `capabilities` CLI.'

      built = component 'Built-graph reader' {
        technology 'capabilities.built'
        description 'Checks the fingerprint, rebuilds when stale, and loads the built graph into memory, with where each quantity value came from.'
      }
      reasoner = component 'Reasoner' {
        technology 'capabilities.reasoner, levels, views'
        description 'Answers Q1 (what would it take), Q2 (what else) and Q3 (could it be done), and shapes results for the UI.'
      }
      places = component 'Places' {
        technology 'capabilities.places, capabilities.built.load_occurrences'
        description 'Where a material or source is found: the occurrences of every source it comes from, summarised per source, as GeoJSON.'
      }
      validator = component 'Validator' {
        technology 'capabilities.validate, jsonschema'
        description 'Checks every curated file against its schema and every cross-reference.'
      }
      cli = component 'CLI' {
        technology 'argparse (`capabilities`)'
        description 'validate, build, backup, queue, need, explore, check, credits, serve.'
      }
    }

    api = container 'API server' {
      technology 'FastAPI, Uvicorn'
      description 'packages/api: the JSON API under /api, and hosts the web app at / and these diagrams at /architecture/.'
    }

    web = container 'Web app' {
      technology 'React, TypeScript, Vite, Cytoscape.js, MapLibre GL JS'
      description 'web/: the graph, selection panes and detail pane, and the map of where things are found (lazy-loaded), built to web/dist.'
    }

    diagrams = container 'Architecture diagrams' {
      technology 'LikeC4'
      description 'docs/architecture/diagrams, built into a static site by `npm run build` in web/.'
    }
  }

  // People and outside systems
  explorer -> capabilities.web 'explores the graph in a browser'
  explorer -> capabilities.diagrams 'reads how it is built'
  contributor -> capabilities.curated 'edits data through pull requests'
  contributor -> capabilities.core.cli 'validates, builds and asks questions'
  contributor -> capabilities.pipeline.dagster 'runs builds and reads lineage in the Dagster UI'
  github -> capabilities 'runs CI on every pull request'

  // Serving
  capabilities.web -> capabilities.api 'calls /api (JSON over HTTP)'
  capabilities.api -> capabilities.web 'hosts the built app'
  capabilities.api -> capabilities.diagrams 'hosts at /architecture/'
  capabilities.api -> capabilities.core.reasoner 'asks the three questions'
  capabilities.api -> capabilities.core.built 'loads the graph at start-up'
  capabilities.api -> capabilities.core.places 'where a material or source is found (/api/occurrences)'
  capabilities.core.places -> capabilities.artifact.occurrences 'loads every occurrence at start-up'
  capabilities.core.places -> capabilities.artifact.manifest 'which upstream snapshots, and when'
  capabilities.web -> openfreemap 'fetches basemap tiles when the map opens'
  capabilities.core.cli -> capabilities.core.reasoner 'asks the three questions'
  capabilities.core.cli -> capabilities.core.built 'loads the graph'
  capabilities.core.cli -> capabilities.core.validator 'validate'
  capabilities.core.validator -> capabilities.curated 'checks every file'

  // Building the graph
  capabilities.core.built -> capabilities.pipeline.loader 'rebuilds when the inputs changed'
  capabilities.core.built -> capabilities.artifact.manifest 'compares fingerprints'
  capabilities.core.built -> capabilities.artifact.graphNodes 'reads every node'
  capabilities.core.built -> capabilities.artifact.graphFacts 'reads where each value came from'
  capabilities.core.built -> capabilities.snapshots 'includes each snapshot.json in the fingerprint'
  capabilities.pipeline.loader -> capabilities.curated 'reads every document'
  capabilities.pipeline.loader -> capabilities.warehouse.rawDocuments 'loads documents, whole'
  capabilities.pipeline.loader -> capabilities.warehouse.rawLoads 'records the inputs fingerprint'
  capabilities.pipeline.loader -> capabilities.warehouse.rawCrosswalk 'loads each crosswalk, as text'
  capabilities.pipeline.loader -> capabilities.snapshots 'reads the snapshots already downloaded'
  capabilities.pipeline.loader -> capabilities.backups 'reads a backup when it is newer than the download, or there is none'
  capabilities.pipeline.downloader -> capabilities.backups 'falls back to it when the network fails'
  capabilities.core.cli -> capabilities.backups 'backup: makes newer downloads the backups'
  capabilities.core.built -> capabilities.backups 'includes each snapshot.json in the fingerprint'
  capabilities.pipeline.loader -> capabilities.warehouse.rawMrds 'loads the newest copy of MRDS'
  capabilities.pipeline.loader -> capabilities.warehouse.rawSnapshots 'records each snapshot loaded'
  capabilities.pipeline.loader -> capabilities.warehouse.rawWikidataCrosswalk 'loads the crosswalk, as text'
  capabilities.pipeline.loader -> capabilities.warehouse.rawSuppressions 'loads the suppressions, as text'
  capabilities.pipeline.loader -> capabilities.warehouse.rawOreMinerals 'loads the ore crosswalk, as text'
  capabilities.pipeline.loader -> capabilities.warehouse.rawWikidataItems 'loads the newest copy of the Wikidata items snapshot'
  capabilities.pipeline.loader -> capabilities.warehouse.rawWikidata 'loads the newest copy of the Wikidata snapshot'
  capabilities.pipeline.dagster -> capabilities.pipeline.downloader 'downloads MRDS and Wikidata as assets'
  capabilities.pipeline.downloader -> mrds 'downloads mrds-csv.zip (HTTPS)'
  capabilities.pipeline.downloader -> wikidata 'one SPARQL query for the crosswalked items (HTTPS)'
  capabilities.pipeline.downloader -> pleiades 'downloads the daily dump of places (HTTPS)'
  capabilities.pipeline.downloader -> openalex 'looks up each cited work, by DOI or title (HTTPS)'
  capabilities.pipeline.downloader -> crossref 'looks up each cited work, by DOI or citation (HTTPS)'
  capabilities.pipeline.loader -> capabilities.warehouse.rawReferenceCandidates 'loads the newest copy of the reference candidates'
  capabilities.warehouse.rawReferenceCandidates -> capabilities.warehouse.stgReferences 'candidates, typed'
  capabilities.warehouse.stgDocuments -> capabilities.warehouse.stgReferences 'every reference cited'
  capabilities.warehouse.stgOreNodes -> capabilities.warehouse.stgReferences 'references of upstream nodes'
  capabilities.warehouse.stgReferences -> capabilities.artifact.checks 'the best candidate for each work'
  capabilities.artifact.checks -> capabilities.artifact.queue 'works not yet read'
  capabilities.pipeline.dbt -> capabilities.artifact.checks 'writes the mart as Parquet, with data tests'
  capabilities.core.built -> capabilities.artifact.checks 'reads each work\'s check, for the detail pane'
  capabilities.pipeline.loader -> capabilities.warehouse.rawPleiades 'loads the newest copy of Pleiades'
  capabilities.pipeline.loader -> capabilities.warehouse.rawPleiadesRules 'loads the rules, as text'
  capabilities.warehouse.rawPleiades -> capabilities.warehouse.stgPleiades 'mines and quarries, typed'
  capabilities.warehouse.stgPleiades -> capabilities.artifact.occurrences 'ancient mines and quarries, as points'
  capabilities.warehouse.rawPleiadesRules -> capabilities.artifact.occurrences 'match rules'
  capabilities.warehouse.stgPleiades -> capabilities.artifact.queue 'unmatched mines and quarries'
  capabilities.pipeline.downloader -> capabilities.curated 'reads the crosswalks, quantities and references to build the queries'
  capabilities.pipeline.downloader -> capabilities.snapshots 'writes Parquet, then snapshot.json'
  capabilities.pipeline.dagster -> capabilities.pipeline.loader 'runs the load and manifest as assets'
  capabilities.pipeline.dagster -> capabilities.pipeline.dbt 'runs every model as an asset, tests as checks'
  capabilities.pipeline.loader -> capabilities.pipeline.dbt 'runs dbt build'
  capabilities.pipeline.loader -> capabilities.artifact.manifest 'writes it last, with the loaded fingerprint'
  capabilities.pipeline.dbt -> capabilities.warehouse.rawDocuments 'source, with data tests'
  capabilities.pipeline.dbt -> capabilities.warehouse.stgDocuments 'builds the staging view'
  capabilities.pipeline.dbt -> capabilities.artifact.graphNodes 'writes the mart as Parquet, with data tests'
  capabilities.pipeline.dbt -> capabilities.warehouse.stgMrds 'builds the staging view'
  capabilities.pipeline.dbt -> capabilities.artifact.occurrences 'writes the mart as GeoParquet, with data tests'
  capabilities.pipeline.dbt -> capabilities.artifact.graphFacts 'writes the mart as Parquet, with data tests'
  capabilities.warehouse.rawDocuments -> capabilities.warehouse.stgDocuments 'parsed into columns'
  capabilities.warehouse.stgDocuments -> capabilities.artifact.graphNodes 'adds provenance'
  capabilities.warehouse.stgDocuments -> capabilities.warehouse.stgCuratedQuantities 'quantities, overrides, properties'
  capabilities.warehouse.rawWikidata -> capabilities.warehouse.stgWikidata 'typed'
  capabilities.warehouse.stgWikidata -> capabilities.artifact.graphFacts 'upstream values'
  capabilities.warehouse.stgCuratedQuantities -> capabilities.artifact.graphFacts 'curated values and overrides'
  capabilities.warehouse.rawWikidataCrosswalk -> capabilities.artifact.graphFacts 'which item each thing is'
  capabilities.warehouse.rawSuppressions -> capabilities.artifact.graphFacts 'items left out'
  capabilities.warehouse.rawSuppressions -> capabilities.artifact.occurrences 'deposits left out'
  capabilities.artifact.graphFacts -> capabilities.artifact.graphNodes 'the chosen values, into each document'
  capabilities.warehouse.rawOreMinerals -> capabilities.warehouse.stgOreNodes 'one mineral, deposit and route per row'
  capabilities.warehouse.rawWikidataItems -> capabilities.warehouse.stgOreNodes 'labels, descriptions, formulas'
  capabilities.warehouse.stgOreNodes -> capabilities.artifact.graphNodes 'upstream nodes, after the curated ones'
  capabilities.warehouse.rawOreMinerals -> capabilities.artifact.occurrences 'the deposits of each mineral'
  capabilities.artifact.graphNodes -> capabilities.artifact.queue 'materials without routes, sources without places, unverified routes'
  capabilities.warehouse.stgMrds -> capabilities.artifact.queue 'ore candidates'
  capabilities.pipeline.dbt -> capabilities.artifact.queue 'writes the mart as Parquet, with data tests'
  capabilities.core.cli -> capabilities.artifact.queue 'queue: prints it'
  capabilities.warehouse.rawMrds -> capabilities.warehouse.stgMrds 'typed, lists split'
  capabilities.warehouse.stgMrds -> capabilities.artifact.occurrences 'deposits with coordinates, as points'
  capabilities.warehouse.rawCrosswalk -> capabilities.artifact.occurrences 'match rules'
  capabilities.warehouse.rawSnapshots -> capabilities.artifact.occurrences 'retrieval time, for provenance'

  contributor -> capabilities.pipeline.agents 'launches an agent run by hand, and merges or closes its pull request'
  capabilities.pipeline.dagster -> capabilities.pipeline.agents 'runs the agent_curation job'
  capabilities.pipeline.agents -> capabilities.artifact.queue 'takes the top ore candidates, or the unverified routes'
  capabilities.pipeline.agents -> claude 'asks the proposer to choose and the reviewer to challenge (claude -p, no tools)'
  capabilities.pipeline.agents -> theWeb 'downloads each source once, and finds the passages naming the mineral or the route\'s thing'
  capabilities.pipeline.agents -> wikidata 'searches for the mineral\'s item, and reads it'
  capabilities.pipeline.agents -> openalex 'searches open-access works on the mineral and smelting, or the route\'s process'
  capabilities.pipeline.agents -> capabilities.pipeline.downloader 'gate: downloads what the changes need'
  capabilities.pipeline.agents -> capabilities.pipeline.loader 'gate: validates, builds and tests the worktree'
  capabilities.pipeline.agents -> capabilities.audit 'appends every call, check and outcome'
  capabilities.pipeline.agents -> github 'pushes agents/<run> and opens a draft pull request (gh)'
  github -> capabilities.curated 'a merged pull request adds the rows, or the routes\' references'

  // Lineage: the data, stage to stage, the way it flows (view pipeline).
  mrds -[lineage]-> capabilities.snapshots 'mrds-csv.zip, as Parquet'
  wikidata -[lineage]-> capabilities.snapshots 'two query results, as Parquet'
  pleiades -[lineage]-> capabilities.snapshots 'the daily dump, as Parquet'
  openalex -[lineage]-> capabilities.snapshots 'works found, as Parquet'
  crossref -[lineage]-> capabilities.snapshots 'works found, as Parquet'
  capabilities.snapshots -[lineage]-> capabilities.warehouse.rawReferenceCandidates 'the download, if newest'
  capabilities.backups -[lineage]-> capabilities.warehouse.rawReferenceCandidates 'the backup, if newest'
  capabilities.artifact.checks -[lineage]-> capabilities.artifact.manifest 'its row count'
  capabilities.artifact.checks -[lineage]-> capabilities.core.built 'each work\'s check'
  capabilities.curated -[lineage]-> capabilities.warehouse.rawPleiadesRules 'pleiades_sources.csv'
  capabilities.snapshots -[lineage]-> capabilities.warehouse.rawPleiades 'the download, if newest'
  capabilities.backups -[lineage]-> capabilities.warehouse.rawPleiades 'the backup, if newest'
  capabilities.snapshots -[lineage]-> capabilities.backups 'capabilities backup, when newer'
  capabilities.curated -[lineage]-> capabilities.warehouse.rawDocuments 'every document, whole'
  capabilities.curated -[lineage]-> capabilities.warehouse.rawCrosswalk 'mrds_sources.csv'
  capabilities.curated -[lineage]-> capabilities.warehouse.rawWikidataCrosswalk 'wikidata_things.csv'
  capabilities.curated -[lineage]-> capabilities.warehouse.rawOreMinerals 'ore_minerals.csv'
  capabilities.curated -[lineage]-> capabilities.warehouse.rawSuppressions 'suppressed_records.csv'
  capabilities.curated -[lineage]-> capabilities.warehouse.rawLoads 'the inputs fingerprint'
  capabilities.snapshots -[lineage]-> capabilities.warehouse.rawMrds 'the download, if newest'
  capabilities.snapshots -[lineage]-> capabilities.warehouse.rawWikidata 'the download, if newest'
  capabilities.snapshots -[lineage]-> capabilities.warehouse.rawWikidataItems 'the download, if newest'
  capabilities.backups -[lineage]-> capabilities.warehouse.rawMrds 'the backup, if newest'
  capabilities.backups -[lineage]-> capabilities.warehouse.rawWikidata 'the backup, if newest'
  capabilities.backups -[lineage]-> capabilities.warehouse.rawWikidataItems 'the backup, if newest'
  capabilities.backups -[lineage]-> capabilities.warehouse.rawSnapshots 'which copy, and when retrieved'
  capabilities.snapshots -[lineage]-> capabilities.warehouse.rawSnapshots 'which copy, and when retrieved'
  capabilities.warehouse.rawLoads -[lineage]-> capabilities.artifact.manifest 'the fingerprint, written last'
  capabilities.warehouse.rawSnapshots -[lineage]-> capabilities.artifact.manifest 'the copies used'
  capabilities.artifact.graphNodes -[lineage]-> capabilities.artifact.manifest 'its row count'
  capabilities.artifact.graphFacts -[lineage]-> capabilities.artifact.manifest 'its row count'
  capabilities.artifact.occurrences -[lineage]-> capabilities.artifact.manifest 'its row count'
  capabilities.artifact.queue -[lineage]-> capabilities.artifact.manifest 'its row count'
  capabilities.artifact.graphNodes -[lineage]-> capabilities.core.built 'every node'
  capabilities.artifact.graphFacts -[lineage]-> capabilities.core.built 'where each value came from'
  capabilities.artifact.manifest -[lineage]-> capabilities.core.built 'is the build current?'

  // The build as a series of stages, like a deployment pipeline (view pipeline-overview). `capabilities build` runs
  // stages 2 to 4; Dagster's "materialize all" runs 1b to 4. Each stage names the parts that do it, in the detailed
  // pipeline view.
  stageCurated = stage '1a Curated layer' {
    technology 'git: YAML, CSV'
    description 'The inputs people write: things, routes, quantities, overrides, crosswalks and suppressions, reviewed in pull requests.'
  }
  stageDownload = stage '1b Download upstream' {
    technology 'Dagster'
    description 'Dagster only: downloads MRDS, the two Wikidata queries and Pleiades, and looks up every cited work in OpenAlex and Crossref (Downloader). If the network fails, it uses the cold backup instead.'
  }
  stageLoad = stage '2 Load' {
    technology 'Python, DuckDB'
    description 'Loads every input into raw DuckDB tables (Loader). For each upstream dataset it takes the newest copy, download or cold backup, and stops if a dataset has neither.'
  }
  stageTransform = stage '3a Transform' {
    technology 'dbt'
    description 'dbt builds the staging views and the marts: graph nodes, quantity facts, source occurrences, reference checks and the curation queue, written as Parquet. Paired with 3b: dbt runs each model\'s tests right after it.'
  }
  stageTest = stage '3b Test' {
    technology 'dbt data tests, Dagster asset checks'
    description 'Column and singular data tests on every source, staging view and mart. A failure stops the build before it is published.'
  }
  stagePublish = stage '4 Publish' {
    technology 'manifest.json'
    description 'The Loader writes the manifest last, with the fingerprint of the inputs: only now is the build current, and the app will read it.'
  }
  stageServe = stage '5 Serve' {
    technology 'FastAPI, React'
    description 'The API server loads the built graph at start-up (rebuilding first if the inputs changed) and serves the web app.'
  }

  stageCurated -> stageLoad 'curated documents'
  stageDownload -> stageLoad 'upstream snapshots'
  stageLoad -> stageTransform 'raw tables'
  stageTransform -> stageTest 'models'
  stageTest -> stagePublish 'all tests pass'
  stagePublish -> stageServe 'built graph'
}
