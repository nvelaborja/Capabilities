// The vocabulary of the architecture model: kinds of elements and the tags we use (ADR 0039).
specification {
  element actor {
    style {
      shape person
      color indigo
    }
  }
  element system
  element container
  element component {
    style {
      color sky
    }
  }
  element store {
    style {
      shape storage
      color green
    }
  }
  element table {
    style {
      shape cylinder
      color green
    }
  }
  element file {
    style {
      shape document
      color green
    }
  }
  // A step of the build, for the pipeline-at-a-glance view: what happens, in order, not which part does it.
  element stage {
    style {
      shape rectangle
      color amber
    }
  }
  element external {
    style {
      color muted
    }
  }

  // Where data goes next, drawn the way it flows (for the detailed pipeline view). Other relationships say which part
  // acts on which, and often point against the flow ("the Loader reads the curated layer").
  relationship lineage {
    color green
    line solid
  }

  tag generated
}
