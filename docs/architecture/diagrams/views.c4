// The diagrams. `index` is the master diagram of the whole project; add to it as the project grows (ADR 0039).
views {

  view index {
    title 'Capabilities: the whole project'
    description 'Everything that exists today: who uses it, the parts of the system, and how data flows from the curated YAML and upstream datasets to the browser.'
    include *
    include capabilities.*
    include capabilities.core.*, capabilities.pipeline.*
    exclude capabilities.core, capabilities.pipeline
    exclude element.kind = stage
    exclude * -> * where kind is lineage
    style capabilities.artifact, capabilities.warehouse, capabilities.snapshots {
      border dashed
    }
  }

  view pipeline_overview {
    title 'The data pipeline at a glance'
    description 'The build as a series of stages, like a deployment pipeline. `capabilities build` runs stages 2 to 4; Dagster runs 1b to 4. Open a stage for the detailed pipeline.'
    include stageCurated with {
      navigateTo pipeline
    }
    include stageDownload with {
      navigateTo pipeline
    }
    include stageLoad with {
      navigateTo pipeline
    }
    include stageTransform with {
      navigateTo pipeline
    }
    include stageTest with {
      navigateTo pipeline
    }
    include stagePublish with {
      navigateTo pipeline
    }
    include stageServe with {
      navigateTo pipeline
    }
    autoLayout LeftRight
  }

  view pipeline {
    title 'The data pipeline'
    description 'Every input, table and output of the build, stage by stage from left to right as in the pipeline at a glance. Green arrows are where the data goes next; each stage holds the part that does it (docs/architecture/data-pipeline.md).'
    group '1a Curated layer' {
      include capabilities.curated
    }
    group '1b Download upstream (Dagster)' {
      include mrds, wikidata, pleiades
      include capabilities.pipeline.dagster, capabilities.pipeline.downloader
      include capabilities.snapshots, capabilities.backups
    }
    group '2 Load: raw tables (DuckDB)' {
      include capabilities.pipeline.loader
      include capabilities.warehouse.rawDocuments, capabilities.warehouse.rawCrosswalk, capabilities.warehouse.rawWikidataCrosswalk
      include capabilities.warehouse.rawOreMinerals, capabilities.warehouse.rawWikidataItems, capabilities.warehouse.rawSuppressions
      include capabilities.warehouse.rawWikidata, capabilities.warehouse.rawMrds, capabilities.warehouse.rawSnapshots, capabilities.warehouse.rawLoads
      include capabilities.warehouse.rawPleiades, capabilities.warehouse.rawPleiadesRules
    }
    group '3a/3b Transform and test (dbt)' {
      include capabilities.pipeline.dbt
      include capabilities.warehouse.stgDocuments, capabilities.warehouse.stgCuratedQuantities, capabilities.warehouse.stgWikidata
      include capabilities.warehouse.stgOreNodes, capabilities.warehouse.stgMrds, capabilities.warehouse.stgPleiades
      include capabilities.artifact.graphNodes, capabilities.artifact.graphFacts, capabilities.artifact.queue, capabilities.artifact.occurrences
    }
    group '4 Publish' {
      include capabilities.artifact.manifest
    }
    group '5 Serve' {
      include capabilities.core.built
    }
    // Which part acts on which: kept in the model, left out here, since most point against the flow. Each part sits in
    // the stage it does instead.
    // Stages, not containers: the parts are grouped by what they do in the build.
    exclude capabilities, capabilities.pipeline, capabilities.warehouse, capabilities.artifact, capabilities.core
    exclude capabilities.pipeline.loader -> *
    exclude capabilities.pipeline.dbt -> *
    exclude capabilities.core.built -> *
    exclude capabilities.pipeline.dagster -> capabilities.pipeline.loader
    exclude capabilities.pipeline.dagster -> capabilities.pipeline.dbt
    exclude capabilities.pipeline.downloader -> mrds
    exclude capabilities.pipeline.downloader -> wikidata
    exclude capabilities.pipeline.downloader -> pleiades
    exclude capabilities.pipeline.downloader -> capabilities.curated
    autoLayout LeftRight
  }

}
