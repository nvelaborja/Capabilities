{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:capabilities:schema:profile",
  "title": "Profile",
  "description": "A curated preset of things a group of people is known to have made or done. In the tool these are 'selected'; everything else that follows from them is 'reachable'. Users start from a profile and toggle items on or off.",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:capabilities:schema:defs#/$defs/common"
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "includes"
  ],
  "properties": {
    "kind": {
      "const": "profile"
    },
    "region": {
      "description": "Used only for regional-availability warnings.",
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "urn:capabilities:schema:defs#/$defs/id"
          },
          "notes": {
            "type": "string"
          },
          "references": {
            "$ref": "urn:capabilities:schema:defs#/$defs/references"
          },
          "verb": {
            "$ref": "urn:capabilities:schema:defs#/$defs/id"
          },
          "target": {
            "$ref": "urn:capabilities:schema:defs#/$defs/id"
          }
        },
        "oneOf": [
          {
            "required": [
              "id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "verb"
                  ]
                },
                {
                  "required": [
                    "target"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "verb",
              "target"
            ],
            "not": {
              "required": [
                "id"
              ]
            }
          }
        ],
        "description": "Something the group is known to have made or done: a thing ({id}) or an action ({verb, target})."
      }
    }
  }
}
